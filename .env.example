# Copy this file to .env and fill in your values.
# Amazon Bedrock bearer token (short-term or long-term API key).
AWS_BEARER_TOKEN_BEDROCK=
# AWS region where the Bedrock API key was issued and Claude 4.5 inference
# profiles are available (e.g. ap-southeast-2, us-east-1).
AWS_REGION=ap-southeast-2
